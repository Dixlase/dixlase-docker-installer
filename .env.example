SOFTWARE_NAME=Dixlase
APP_NAME="Dixlase"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=https://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=dixlase,notification
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dixlase
DB_USERNAME=dixlase
DB_PASSWORD=password
DB_ROOT_PASSWORD=root
DB_PREFIX=dls_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@dixlase.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 管理画面の設定
CUSTOM_FILES_DIR=custom
DEFAULT_MERGE_MODE=replace

# 二段階認証の設定
TWO_FACTOR_CODE_EXPIRE=5
TWO_FACTOR_RESEND_INTERVAL=60
TWO_FACTOR_DEVICE_EXPIRE_DAYS=30

# テーマの設定
APP_THEME=DixlaseOnePage

# インストール済みフラグ（クリーンインストール用）
INSTALLED=false

# HTTPS 設定
FORCE_SSL=true

# 拡張機能ダウンロード用GitHubトークン
# ↓ ここに GitHub Classic PAT (repo スコープ) を設定
EXTENSION_GITHUB_TOKEN=

# ====================================================
# Docker ホスト側のポートマッピング
# ローカルで他のサービスとポートが競合する場合のみ変更
# ====================================================
APP_PORT=80
APP_SSL_PORT=443
FORWARD_DB_PORT=3306
FORWARD_ADMINER_PORT=8081
FORWARD_MAILPIT_PORT=8025
FORWARD_REDIS_PORT=6379
FORWARD_VITE_PORT=5173
