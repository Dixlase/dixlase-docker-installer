# ====================================================
# HTTPS toggle
# false : serve on port 80 in plain HTTP, no redirect. The browser
#         opens the install wizard without a self-signed-cert warning.
#         Default.
# true  : serve on port 443 with the bundled self-signed certificate;
#         port 80 redirects to HTTPS. Use when you need TLS locally.
# After changing this value, re-run ./setup.sh.
# ====================================================
HTTPS=false

# ====================================================
# Optional containers (toggle on/off)
# VITE  : start the Vite dev server (hot-reload). Same effect as
#         passing --dev to setup.sh. Default: false.
# REDIS : start the Redis container (used by Laravel for cache /
#         sessions / queues). Default: false. Set to true to enable;
#         when enabling, also point Laravel's CACHE_STORE and
#         SESSION_DRIVER at redis.
# CRON  : start a small container that invokes Laravel's
#         `php artisan schedule:run` every minute. Required for
#         automatic extension update checks (the
#         `extension_update_check_interval` security setting) to
#         actually fire — without it, update checks only run when
#         someone opens the admin update page. Default: true. Set
#         to false only if you already run `schedule:run` from a
#         host cron / systemd timer / other scheduler.
# TOOLS : start the local development tools — Adminer (database GUI)
#         and Mailpit (mail catcher). Default: true, published on
#         127.0.0.1 only. Neither asks for a password of its own:
#         Adminer signs in to MariaDB with the credentials below, and
#         Mailpit shows every captured mail. Set to false on any host
#         where you would rather not run them at all.
# After changing any value, re-run ./setup.sh.
# ====================================================
VITE=false
REDIS=false
CRON=true
TOOLS=true

# ====================================================
# Container name prefix
# Each service in docker-compose.yml is named "<prefix>-<service>"
# (e.g. dixlase-app, dixlase-mysql). Change this when running multiple
# Dixlase environments side-by-side on the same Docker host so the
# names do not collide (e.g. "dixlase-brand", "dixlase-staging").
# After changing this value, re-run ./setup.sh.
# ====================================================
CONTAINER_PREFIX=dixlase

# ====================================================
# Docker Compose project name
# Controls how Docker Desktop and `docker compose ls` group this
# environment, and the prefix Compose uses for auto-named resources
# (networks, named volumes). When unset, Compose falls back to the
# directory name (e.g. "docker"), which is rarely meaningful. Keep
# this in sync with CONTAINER_PREFIX so the dashboard grouping
# matches the container names.
# After changing this value, re-run ./setup.sh.
# ====================================================
COMPOSE_PROJECT_NAME=dixlase

# ====================================================
# Docker host-side port mapping
# Defaults use the 4xxxx namespace ("4" = D = Dixlase's initial,
# alphabetically the 4th letter) so they do not collide with services
# already bound to 80 / 443 / 3306 / 6379 / 5173 on the host. Change
# to the standard ports (or any free ports) if you have no conflict.
# ====================================================
APP_PORT=40080
APP_SSL_PORT=40443
FORWARD_DB_PORT=40306
FORWARD_ADMINER_PORT=40081
FORWARD_MAILPIT_PORT=40025
FORWARD_VITE_PORT=40173
# Redis has no host-side port on purpose: containers reach it at redis:6379
# over the compose network, and it runs without a password. See the redis
# service in docker-compose.yml if you need a host-side client anyway.

# ====================================================
# Host-binding addresses.
# Default 127.0.0.1 keeps each service reachable only from THIS machine
# (TablePlus / Sequel Ace and a browser on the same host still work). Set
# one to 0.0.0.0 ONLY if you intentionally need LAN-wide access — that is
# what akiramysql-style ransom bots scan for, and they did compromise
# unprotected Docker dev setups in the wild.
#
# The site itself (APP_PORT / APP_SSL_PORT) is deliberately not on this
# list: serving it is the point. Everything here is a tool that trusts
# whoever can reach it — the database accepts the credentials below,
# Adminer hands them to the database for you, Mailpit shows every mail,
# and the Vite dev server can read files under html/.
#
# setup.sh warns when one of these is not a loopback address while the
# database passwords are still the defaults.
# ====================================================
DB_BIND_ADDRESS=127.0.0.1
ADMINER_BIND_ADDRESS=127.0.0.1
MAILPIT_BIND_ADDRESS=127.0.0.1
VITE_BIND_ADDRESS=127.0.0.1

# ====================================================
# Database credentials (used by docker-compose to bootstrap MariaDB).
# Enter the same values during the Dixlase install wizard.
#
# These defaults are for a local trial. They are fine while MariaDB and
# Adminer stay on 127.0.0.1, and an open door the moment they do not.
# Change them before exposing this host, and note that MariaDB only reads
# them when its data directory is created — on an existing install, change
# the passwords in MariaDB itself, or start over with ./reset.sh.
# ====================================================
DB_DATABASE=dixlase
DB_USERNAME=dixlase
DB_PASSWORD=dixlase
DB_ROOT_PASSWORD=root

# ====================================================
# DB privilege separation (opt-in, recommended for production).
#
# When both variables are set AND the MariaDB data directory is fresh,
# mysql-initdb/01-permissions.sh fires on first boot and:
#   - strips DDL grants from ${DB_USERNAME} (the app account is then
#     limited to SELECT/INSERT/UPDATE/DELETE)
#   - creates ${DB_MIGRATE_USERNAME} with ALL PRIVILEGES
# Migrations must subsequently be run with:
#   php artisan migrate --database=mysql_migrate
#
# When either variable is empty, MariaDB stays in the legacy
# single-user mode and the init hook is a no-op.
#
# For existing installs the data directory is no longer fresh, so the
# init hook will not re-fire; follow the manual retrofit procedure in
# the Core repo's docs/operations/db-privilege-separation.md.
#
# Background: 2026-05-29 production schema-wipe incident, see
# docs/incidents/2026-05-29-mysql-tables-dropped.md in the Core repo.
# ====================================================
#DB_MIGRATE_USERNAME=dixlase_migrator
#DB_MIGRATE_PASSWORD=

# ====================================================
# php-fpm opcache reset token (web-triggered core updates).
#
# After a web-triggered core update, the deployed app must refresh
# php-fpm's opcache so the new code takes effect. It does this by POSTing
# to the internal /system/fpm-cache-reset endpoint (routed via the web
# service), authenticated with this shared token. Signalling php-fpm with
# SIGUSR2 is not an option here because php-fpm runs as PID 1 and the
# www-data worker may not signal it.
#
# Leave empty: setup.sh generates a random token on first run and writes
# it here, then docker-compose passes it to the app container as
# CORE_FPM_RESET_TOKEN (see docker-compose.yml).
# ====================================================
CORE_FPM_RESET_TOKEN=

# ====================================================
# Extra compose files (optional)
# Uncomment to mount the host's SSH keys into the app container, which the
# DixlaseDeploy plugin's CLI needs. Everything in the container can then
# read those keys, so leave it off unless you deploy from here — see
# docker-compose.deploy.yml and SECURITY.md.
# ====================================================
#COMPOSE_FILE=docker-compose.yml:docker-compose.deploy.yml
