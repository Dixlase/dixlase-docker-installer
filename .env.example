# ====================================================
# HTTPS toggle
# false : serve on port 80 in plain HTTP, no redirect. The browser
#         opens the install wizard without a self-signed-cert warning.
#         Default.
# true  : serve on port 443 with the bundled self-signed certificate;
#         port 80 redirects to HTTPS. Use when you need TLS locally.
# After changing this value, re-run ./setup.sh.
# ====================================================
HTTPS=false

# ====================================================
# Optional containers (toggle on/off)
# VITE  : start the Vite dev server (hot-reload). Same effect as
#         passing --dev to setup.sh. Default: false.
# REDIS : start the Redis container (used by Laravel for cache /
#         sessions / queues). Default: true. Set to false to skip
#         the container; remember to also point Laravel's CACHE_STORE
#         and SESSION_DRIVER away from redis.
# After changing either value, re-run ./setup.sh.
# ====================================================
VITE=false
REDIS=true

# ====================================================
# Docker host-side port mapping
# Change only when local ports conflict with other services.
# ====================================================
APP_PORT=80
APP_SSL_PORT=443
FORWARD_DB_PORT=3306
FORWARD_ADMINER_PORT=8081
FORWARD_MAILPIT_PORT=8025
FORWARD_REDIS_PORT=6379
FORWARD_VITE_PORT=5173

# ====================================================
# Database credentials (used by docker-compose to bootstrap MariaDB).
# Enter the same values during the Dixlase install wizard.
# ====================================================
DB_DATABASE=dixlase
DB_USERNAME=dixlase
DB_PASSWORD=password
DB_ROOT_PASSWORD=root
