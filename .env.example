# ====================================================
# Docker host-side port mapping
# Change only when local ports conflict with other services.
# ====================================================
APP_PORT=80
APP_SSL_PORT=443
FORWARD_DB_PORT=3306
FORWARD_ADMINER_PORT=8081
FORWARD_MAILPIT_PORT=8025
FORWARD_REDIS_PORT=6379
FORWARD_VITE_PORT=5173

# ====================================================
# Database credentials (used by docker-compose to bootstrap MariaDB).
# Enter the same values during the Dixlase install wizard.
# ====================================================
DB_DATABASE=dixlase
DB_USERNAME=dixlase
DB_PASSWORD=password
DB_ROOT_PASSWORD=root
