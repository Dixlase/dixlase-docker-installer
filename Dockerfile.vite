# Dockerfile.vite - Dixlase
FROM node:24

WORKDIR /var/www/html

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy only package.json (no lock file is shipped with core)
COPY ./html/package.json ./

# npm install (matches the main Dockerfile; npm ci would always fail
# here because there is no package-lock.json to validate against)
RUN npm install

# Copy all source code
COPY ./html ./

# Start the Vite server
EXPOSE 5173

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["npm", "run", "dev"]
