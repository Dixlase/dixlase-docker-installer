node_modules/
# Ignore .claude/ contents by default (session history, caches, local
# plans, etc.) but whitelist the project-level Claude Code config and
# hooks so they ship with every clone. The hooks defend against the
# 2026-05-29 production DROP incident — they block Bash invocations
# like `docker exec dixlase-brand-app php artisan test`.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.sh
.backlog/
